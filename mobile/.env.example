# URL du backend (module IAM + ressources). Sur un appareil physique avec
# Expo Go, « localhost » ne fonctionne pas : utilisez l'IP LAN de la machine
# qui exécute le backend (ex. http://192.168.1.42:8000).
# L'app ajoute automatiquement le préfixe /api/v1.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
