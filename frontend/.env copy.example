# Copier vers .env.local et ajuster si besoin :
# cp .env.example .env.local

# true = données mockées (frontend/src/mocks/) — pas de backend requis
# false = API réelle (redémarrer npm run dev après changement)
VITE_MOCK_API=true

# URL du backend FastAPI (ajouter /api/v1 si votre API l'exige)
VITE_API_URL=http://localhost:8000

# ─── OpenScience AI (assistant conversationnel) ───────────────────
# Modèle Groq utilisé (compatible OpenAI). Ex : llama-3.3-70b-versatile, llama-3.1-8b-instant
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Clé API Groq pour l'appel DIRECT depuis le navigateur (démo locale).
# ⚠️ Embarquée dans le bundle client → ne PAS exposer en production. À mettre dans .env.local.
VITE_GROQ_API_KEY=

# Alternative recommandée en prod : URL d'un proxy qui garde la clé côté serveur.
# Si défini, il est utilisé à la place de l'appel direct (mêmes réponses SSE compatibles OpenAI).
VITE_CHAT_PROXY_URL=
